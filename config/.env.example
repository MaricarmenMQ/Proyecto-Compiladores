# SAM-Lang Studio v2 - configuración local de IA multimodelo.
# Copia este archivo como config/.env o configura los proveedores desde la interfaz.
# NO compartas config/.env cuando contenga claves reales.

AI_PROVIDER=gemini
AI_FALLBACK=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3

PORT=3000

# Despliegue: usar HOST=0.0.0.0. En local puede omitirse.
HOST=127.0.0.1
ALLOW_WEB_CONFIG=true
